{
  "name": "Reachmark Audio",
  "short_name": "Reachmark",
  "id": "/",
  "scope": "/",
  "start_url": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "lang": "en",
  "dir": "ltr",
  "description": "The worldwide AI voice studio by Reachmark Digital: neural text-to-speech and voice translation in any language, Voice Match, voice changer, dubbing, lip sync and character agents that talk and call in their own voice.",
  "categories": ["productivity", "music", "utilities", "business"],
  "background_color": "#151310",
  "theme_color": "#151310",
  "orientation": "portrait-primary",
  "icons": [
    { "src": "/assets/icon-96.png", "sizes": "96x96", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Text to Speech", "short_name": "TTS", "description": "Generate speech in any voice and language", "url": "/#/studio/tts", "icons": [{ "src": "/assets/icon-96.png", "sizes": "96x96" }] },
    { "name": "Voice Match", "short_name": "Match", "description": "Match a neural voice to you from 10 seconds of audio", "url": "/#/studio/clone", "icons": [{ "src": "/assets/icon-96.png", "sizes": "96x96" }] },
    { "name": "Support Center", "short_name": "Support", "description": "Live chat and support sessions", "url": "/#/support", "icons": [{ "src": "/assets/icon-96.png", "sizes": "96x96" }] }
  ],
  "screenshots": [
    { "src": "/assets/screenshot-desktop.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "Reachmark Audio dashboard on desktop" },
    { "src": "/assets/screenshot-mobile.png", "sizes": "750x1334", "type": "image/png", "form_factor": "narrow", "label": "Reachmark Audio studio list on mobile" }
  ],
  "share_target": {
    "action": "/?share=1",
    "method": "GET",
    "params": { "title": "rm_title", "text": "rm_text" }
  },
  "file_handlers": [
    {
      "action": "/#/studio/changer",
      "accept": { "audio/*": [".wav", ".mp3", ".ogg", ".m4a", ".flac"] }
    }
  ],
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "prefer_related_applications": false
}
