{
  "name": "Reachmark Audio",
  "short_name": "Reachmark Voice",
  "id": "/",
  "scope": "/",
  "start_url": "/",
  "display": "standalone",
  "lang": "en",
  "dir": "ltr",
  "description": "Reachmark Voice is the AI voice studio for text-to-speech, voice matching, dubbing, translation and conversational character agents.",
  "categories": [
    "productivity",
    "music",
    "utilities",
    "business"
  ],
  "background_color": "#171812",
  "theme_color": "#C9F36A",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Text to Speech",
      "short_name": "TTS",
      "description": "Generate speech in any voice and language",
      "url": "/#/studio/tts",
      "icons": [
        {
          "src": "/assets/shortcut-tts-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Voice Match",
      "short_name": "Match",
      "description": "Match a neural voice to you from 10 seconds of audio",
      "url": "/#/studio/clone",
      "icons": [
        {
          "src": "/assets/shortcut-match-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Support Center",
      "short_name": "Support",
      "description": "Live chat and support sessions",
      "url": "/#/support",
      "icons": [
        {
          "src": "/assets/shortcut-support-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/assets/screenshot-desktop.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Reachmark Audio dashboard on desktop"
    },
    {
      "src": "/assets/screenshot-mobile.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Reachmark Audio studio list on mobile"
    }
  ],
  "share_target": {
    "action": "/?share=1",
    "method": "GET",
    "params": {
      "title": "rm_title",
      "text": "rm_text"
    }
  },
  "file_handlers": [
    {
      "action": "/#/studio/changer",
      "accept": {
        "audio/*": [
          ".wav",
          ".mp3",
          ".ogg",
          ".m4a",
          ".flac"
        ]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+reachmark",
      "url": "/?proto=%s"
    }
  ],
  "note_taking": {
    "new_note_url": "/?note=1"
  },
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "edge_side_panel": {
    "preferred_width": 420
  },
  "tab_strip": {
    "new_tab_url": "/#/studio/tts"
  },
  "widgets": [
    {
      "name": "Reachmark Audio Studio",
      "description": "Jump straight into the Reachmark Audio studios and see live engine status.",
      "tag": "reachmark-quick-studio",
      "ms_ac_template": "/widget/quick-studio.ac.json",
      "data": "/widget.html",
      "type": "text/html",
      "update": 60,
      "screenshots": [
        {
          "src": "/assets/widget-screenshot.png",
          "sizes": "600x400",
          "type": "image/png",
          "label": "Reachmark Audio Studio widget"
        }
      ],
      "icons": [
        {
          "src": "/assets/icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "prefer_related_applications": false,
  "display_override": [
    "standalone",
    "window-controls-overlay"
  ]
}
