# Reachmark Audio — environment reference (copy to .env for local dev; NEVER commit real secrets)
# Railway picks the non-secret defaults up automatically from railway.json → "variables".
# The five secret keys below are created EMPTY by railway.json — paste their values once
# in the Railway dashboard (or: railway variables set KEY=value) so they stay out of git.

# ---- core ----
NODE_ENV=production
PORT=8000
ADMIN_PORT=8001
DATA_DIR=./data                      # Railway/Docker: /data (the mounted volume)
PIPER_VOICES_DIR=./engines/piper-voices   # Docker image bakes voices here at build time

# ---- public links used in emails ----
PUBLIC_URL=http://localhost:8000     # Railway: https://${{RAILWAY_PUBLIC_DOMAIN}} (auto)
ADMIN_URL=http://localhost:8001      # base for admin inbox links in notification emails

# ---- company / support ----
SUPPORT_EMAIL=support@reachmarkdigital.com

# ---- transactional email (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587                        # 465 = implicit TLS
SMTP_USER=reachmarkofficial@gmail.com
SMTP_PASS=                           # SECRET: Gmail app password (16 chars, no spaces)
MAIL_FROM=Reachmark Audio <reachmarkofficial@gmail.com>

# ---- admin control room ----
ADMIN_EMAIL=                         # SECRET: first admin login (env-seeded, never signup)
ADMIN_PASSWORD=                      # SECRET: strong temp password; TOTP enrolls at first login
ADMIN_IP_ALLOWLIST=                  # optional: comma-separated IPs allowed to reach admin APIs

# ---- outbound AI phone calls (Twilio; optional) ----
TWILIO_ACCOUNT_SID=                 # SECRET: Twilio Account SID (AC...)
TWILIO_AUTH_TOKEN=                  # SECRET: Twilio Auth Token
TWILIO_FROM_NUMBER=                 # Twilio-owned number in E.164 format, e.g. +14155550123
# PUBLIC_URL must be the public HTTPS base URL reachable by Twilio webhooks.

# ---- encrypted agent messaging integrations (optional) ----
APP_ENCRYPTION_KEY=                 # SECRET: random 32+ character key; keep stable or encrypted channel credentials cannot be read
WHATSAPP_GRAPH_VERSION=v23.0         # Optional Meta Graph API version override

# ---- character agents (optional) ----
LLM_API_KEY=                         # SECRET: any OpenAI-compatible key; without it agents use the local persona brain
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# --- cloud engines (optional, secrets never committed) ---
ELEVENLABS_API_KEY=            # ElevenLabs key: real Voice Design previews + multilingual TTS
TTS_MODEL=eleven_multilingual_v2
ANTHROPIC_API_KEY=             # Anthropic key: Claude answers character agents in-character
CLAUDE_MODEL=claude-sonnet-5-5

# Web push (optional — auto-generated and persisted in DATA_DIR/vapid.json when unset)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
