# Reachmark Voice server configuration
# Keep these values server-side. Do not prefix them with NEXT_PUBLIC_.

REACHMARK_PRODUCT_NAME="Reachmark Voice"
REACHMARK_TTS_URL=http://127.0.0.1:8000/synthesize
REACHMARK_AGENT_URL=http://127.0.0.1:8080/v1/chat/completions
REACHMARK_BACKEND_TOKEN=
LOG_LEVEL=info

# Production: point the URLs at a private, authenticated gateway when the
# Next.js runtime is hosted separately from the GPU server.
