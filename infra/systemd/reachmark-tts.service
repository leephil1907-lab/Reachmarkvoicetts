[Unit]
Description=Reachmark Voice TTS (XTTS)
After=network.target

[Service]
Type=simple
User=reachmark
Group=reachmark
WorkingDirectory=/opt/reachmark/tts-service
Environment=PATH=/opt/reachmark/tts-service/.venv/bin
ExecStart=/opt/reachmark/tts-service/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
