[Unit]
Description=Reachmark Voice LLM (llama.cpp)
After=network.target

[Service]
Type=simple
User=reachmark
Group=reachmark
WorkingDirectory=/opt/llama.cpp
ExecStart=/opt/llama.cpp/server \
  -m /opt/models/dolphin-3-8b/dolphin-3.0-llama-3.1-8b.Q4_K_M.gguf \
  -c 4096 \
  --n-gpu-layers 35 \
  -t 8 \
  --host 127.0.0.1 \
  --port 8080
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
